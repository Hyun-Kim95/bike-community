NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://user:password@localhost:5432/bike_community
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=bike-community-uploads
ADMIN_JWT_SECRET=admin-jwt-secret-min-32-chars

# 초기 관리자 (npm run seed:admin 시 사용)
ADMIN_INIT_EMAIL=admin@bike.local
ADMIN_INIT_PASSWORD=admin1234!
